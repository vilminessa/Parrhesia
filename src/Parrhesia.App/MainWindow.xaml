<Window x:Class="Parrhesia.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Parrhesia.App.Views"
        Title="Parrhesia"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource Brush.Deep}"
        Foreground="{DynamicResource Brush.Text}">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40"
                  ResizeBorderThickness="6"
                  CornerRadius="0"
                  GlassFrameThickness="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Заголовок окна -->
    <Grid Grid.Row="0" Background="{DynamicResource Brush.Panel}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
        <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Accent}" />
        <TextBlock Text="Parrhesia"
                   Margin="9,0,0,0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text}"
                   VerticalAlignment="Center" />
        <TextBlock Text="модульный аудио-микшер"
                   Margin="12,1,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource Brush.TextFaint}"
                   VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Style="{StaticResource TitleBarButton}"
                Click="OnMinimizeClick"
                ToolTip="Свернуть">
          <Path Width="10"
                Height="1"
                Stretch="Fill"
                Data="M0,0 H10"
                Stroke="{DynamicResource Brush.Text}"
                StrokeThickness="1" />
        </Button>
        <Button Style="{StaticResource TitleBarButton}"
                Click="OnMaximizeClick"
                ToolTip="Развернуть">
          <Grid Width="10" Height="10">
            <Rectangle Width="10"
                       Height="10"
                       Stroke="{DynamicResource Brush.Text}"
                       StrokeThickness="1" />
            <Rectangle x:Name="RestoreIcon"
                       Width="8"
                       Height="8"
                       Margin="3,0,0,3"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Stroke="{DynamicResource Brush.Text}"
                       StrokeThickness="1"
                       Visibility="Collapsed" />
          </Grid>
        </Button>
        <Button Style="{StaticResource TitleBarCloseButton}"
                Click="OnCloseClick"
                ToolTip="Закрыть">
          <Path Width="10"
                Height="10"
                Stretch="Fill"
                Data="M0,0 L10,10 M10,0 L0,10"
                Stroke="{DynamicResource Brush.Text}"
                StrokeThickness="1" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Вкладки профилей -->
    <views:ProfileStripView Grid.Row="1" />

    <!-- Навигация -->
    <TabControl x:Name="Tabs" Grid.Row="2" Margin="0,1,0,0">
      <TabItem Header="Микшер">
        <views:MixerView />
      </TabItem>
      <TabItem Header="Схема">
        <views:GraphView />
      </TabItem>
      <TabItem Header="Устройства">
        <views:DevicesView />
      </TabItem>
      <TabItem Header="Настройки">
        <views:SettingsView />
      </TabItem>
      <TabItem Header="Диагностика">
        <views:DiagnosticsView />
      </TabItem>
    </TabControl>
  </Grid>
</Window>
