<Window x:Class="Parrhesia.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Parrhesia.App.Views"
        Title="Parrhesia"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource Brush.Deep}"
        Foreground="{DynamicResource Brush.Text}">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40"
                  ResizeBorderThickness="6"
                  CornerRadius="0"
                  GlassFrameThickness="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Фон-сцены тем: луна (Moon, скрыта) и стекло (Liquid Glass).
         Статичные, IsHitTestVisible=false; слой включает ThemeManager
         по CurrentBackdrop (первый child = под всем содержимым). -->
    <Border x:Name="ThemeBackdrop"
            Grid.Row="0"
            Grid.RowSpan="3"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            ClipToBounds="True">
      <Grid>
        <!-- Moon: статичная детализированная луна (фото CC0) с мягким свечением -->
        <Grid x:Name="MoonScene"
              Width="460"
              Height="460"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,64,110,0"
              Visibility="Collapsed">
          <!-- Мягкое лунное свечение (тёмная ночь темы Moon) -->
          <Ellipse Width="460" Height="460">
            <Ellipse.Fill>
              <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#2A3140" Offset="0" />
                <GradientStop Color="#04030A88" Offset="0.55" />
                <GradientStop Color="#04030A00" Offset="1" />
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>

          <!-- Луна: фото в круглой маске (космос луны сливается с ночным фоном) -->
          <Ellipse Width="350" Height="350" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Effect>
              <DropShadowEffect Color="#9AA4B4"
                                BlurRadius="70"
                                ShadowDepth="0"
                                Opacity="0.45" />
            </Ellipse.Effect>
            <Ellipse.Fill>
              <ImageBrush ImageSource="Assets/moon.jpg" Stretch="UniformToFill" />
            </Ellipse.Fill>
          </Ellipse>
        </Grid>

        <!-- Liquid Glass: тёмно-синяя «вода за стеклом» (всё окно) -->
        <Grid x:Name="GlassScene" Visibility="Collapsed">
          <Border>
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                <GradientStop Color="#FF0A1430" Offset="0" />
                <GradientStop Color="#FF071026" Offset="0.55" />
                <GradientStop Color="#FF05080F" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <!-- Глубина: пятна «воды» -->
          <Ellipse Width="900"
                   Height="900"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="-260,-300,0,0">
            <Ellipse.Fill>
              <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#3A5FB055" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Ellipse Width="1100"
                   Height="800"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,-300,-250">
            <Ellipse.Fill>
              <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#2B4C8A66" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>

          <!-- Световой блик сверху (стеклянный верхний скос) -->
          <Ellipse Width="1400"
                   Height="520"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,-330,0,0">
            <Ellipse.Fill>
              <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#69C1FF26" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>

          <!-- Акцентный отсвет снизу-слева -->
          <Ellipse Width="800"
                   Height="600"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="-220,0,0,-200">
            <Ellipse.Fill>
              <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#69C1FF1A" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
        </Grid>
      </Grid>
    </Border>

    <!-- Заголовок окна -->
    <Grid Grid.Row="0" Background="{DynamicResource Brush.Panel}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
        <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Accent}" />
        <TextBlock Text="Parrhesia"
                   Margin="9,0,0,0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text}"
                   VerticalAlignment="Center" />
        <TextBlock Text="модульный аудио-микшер"
                   Margin="12,1,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource Brush.TextFaint}"
                   VerticalAlignment="Center" />
        <!-- Версия сборки: 0.0.0-dev → «unreleased», из тега - релизная (см. Directory.Build.props) -->
        <TextBlock x:Name="VersionText"
                   Margin="12,1,0,0"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextFaint}"
                   VerticalAlignment="Center"
                   Text="unreleased" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Style="{StaticResource TitleBarButton}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Click="OnMinimizeClick"
                ToolTip="Свернуть">
          <Path Width="10"
                Height="1"
                Stretch="Fill"
                Data="M0,0 H10"
                Stroke="{DynamicResource Brush.Text}"
                StrokeThickness="1" />
        </Button>
        <Button Style="{StaticResource TitleBarButton}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Click="OnMaximizeClick"
                ToolTip="Развернуть">
          <Grid Width="10" Height="10">
            <Rectangle Width="10"
                       Height="10"
                       Stroke="{DynamicResource Brush.Text}"
                       StrokeThickness="1" />
            <Rectangle x:Name="RestoreIcon"
                       Width="8"
                       Height="8"
                       Margin="3,0,0,3"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Stroke="{DynamicResource Brush.Text}"
                       StrokeThickness="1"
                       Visibility="Collapsed" />
          </Grid>
        </Button>
        <Button Style="{StaticResource TitleBarCloseButton}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Click="OnCloseClick"
                ToolTip="Закрыть">
          <Path Width="10"
                Height="10"
                Stretch="Fill"
                Data="M0,0 L10,10 M10,0 L0,10"
                Stroke="{DynamicResource Brush.Text}"
                StrokeThickness="1" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Вкладки профилей -->
    <views:ProfileStripView Grid.Row="1" />

    <!-- Навигация -->
    <TabControl x:Name="Tabs" Grid.Row="2" Margin="0,1,0,0">
      <TabItem Header="Микшер">
        <views:MixerView />
      </TabItem>
      <TabItem Header="Схема">
        <views:GraphView />
      </TabItem>
      <TabItem Header="Устройства">
        <views:DevicesView />
      </TabItem>
      <TabItem Header="Кабели">
        <views:CablesView />
      </TabItem>
      <TabItem Header="Настройки">
        <views:SettingsView />
      </TabItem>
      <TabItem Header="Диагностика">
        <views:DiagnosticsView />
      </TabItem>
    </TabControl>
  </Grid>
</Window>
