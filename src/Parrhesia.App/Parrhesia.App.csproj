<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Parrhesia.Core\Parrhesia.Core.csproj" />
    <ProjectReference Include="..\Parrhesia.Audio\Parrhesia.Audio.csproj" />
    <!-- Процесс-исполнитель плагинов (P-волна): spec-режим спавнит
         Parrhesia.Executor.exe (консольный хост) — копируется в наш bin. -->
    <ProjectReference Include="..\Parrhesia.Executor\Parrhesia.Executor.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- TrayService (U3): иконка в трее через WinForms NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Parrhesia.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms используется только TrayService: глобальные implicit-usings
         SDK создают конфликты имён (Button/Point/MessageBox) с WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Drawing.Imaging" />
  </ItemGroup>

  <ItemGroup>
    <!-- Фон темы Moon: полная луна (FullMoon2010, Gregory H. Revera, CC0). -->
    <Resource Include="Assets\moon.jpg" />
  </ItemGroup>

</Project>
