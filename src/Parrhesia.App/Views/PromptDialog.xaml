<Window x:Class="Parrhesia.App.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Panel}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38"
                  ResizeBorderThickness="6"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <StackPanel Margin="18,14,18,16">
    <Grid Margin="0,0,0,12">
      <TextBlock x:Name="TitleText"
                 FontWeight="SemiBold"
                 FontSize="14"
                 Foreground="{DynamicResource Brush.Text}"
                 VerticalAlignment="Center" />
      <Button HorizontalAlignment="Right"
              Style="{StaticResource TitleBarCloseButton}"
              Click="OnCancelClick"
              ToolTip="Отмена">
        <Path Width="10"
              Height="10"
              Stretch="Fill"
              Data="M0,0 L10,10 M10,0 L0,10"
              Stroke="{DynamicResource Brush.Text}"
              StrokeThickness="1" />
      </Button>
    </Grid>

    <TextBox x:Name="ValueBox" />

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="Отмена"
              IsCancel="True"
              Margin="0,0,8,0"
              MinWidth="90" />
      <Button Content="ОК"
              IsDefault="True"
              MinWidth="90"
              Click="OnOkClick" />
    </StackPanel>
  </StackPanel>
</Window>
