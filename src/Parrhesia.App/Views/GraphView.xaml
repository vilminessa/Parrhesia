<UserControl x:Class="Parrhesia.App.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             MouseWheel="OnMouseWheel"
             MouseDown="OnMouseDown"
             MouseMove="OnMouseMove"
             MouseUp="OnMouseUp"
             PreviewKeyDown="OnKeyDown"
             PreviewKeyUp="OnKeyUp"
             Loaded="OnGraphViewLoaded"
             Unloaded="OnGraphViewUnloaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- Тулбар: режим отображения -->
    <Border Grid.Row="0"
            Grid.ColumnSpan="3"
            Margin="14,14,14,0"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Stroke}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.L}"
            Padding="10,7">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Вид"
                   FontSize="12"
                   Foreground="{DynamicResource Brush.TextFaint}"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" />
        <ToggleButton x:Name="SingleModeButton"
                      Content="Однонодовый"
                      IsChecked="True"
                      Checked="OnViewModeChanged"
                      Unchecked="OnViewModeUnchecked" />
        <ToggleButton x:Name="MasteringModeButton"
                      Content="Мастеринг"
                      Margin="8,0,0,0"
                      Checked="OnViewModeChanged"
                      Unchecked="OnViewModeUnchecked" />
      </StackPanel>
    </Border>

    <!-- Инструментарий: добавление узлов -->
    <Border Grid.Row="1"
            Grid.Column="0"
            Width="200"
            Margin="14"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Stroke}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.L}"
            Padding="14,14,14,10">
      <StackPanel>
        <TextBlock Text="Инструментарий"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Foreground="{DynamicResource Brush.Text}"
                   Margin="0,0,0,12" />

        <TextBlock Text="ИСТОЧНИКИ"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextFaint}"
                   Margin="0,0,0,6" />
        <Button Content="Захват устройства"
                Click="OnPaletteAdd"
                Tag="Capture"
                Margin="0,0,0,6" />
        <Button Content="Звук системный"
                Click="OnPaletteAdd"
                Tag="Loopback"
                Margin="0,0,0,6" />
        <Button IsEnabled="False" Margin="0,0,0,10"
                ToolTip="Windows не даёт публичного API перехвата звука отдельного приложения. Направьте приложение в наш кабель: настройки звука приложения → выход «Parrhesia In», и в микшере появится его полоса (зона «Виртуальные кабели»).">
          <Grid>
            <TextBlock Text="Процесс приложения" VerticalAlignment="Center" />
            <TextBlock Text="через кабель"
                       FontSize="10"
                       Foreground="{DynamicResource Brush.TextFaint}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
          </Grid>
        </Button>

        <Button Content="Расставить узлы"
                Click="OnAutoLayoutClick"
                ToolTip="Авто-раскладка по топологии: источники слева, обработка в центре, назначения справа (позиции сохраняются в профиль)"
                Margin="0,10,0,0" />

        <TextBlock Text="ШИНЫ"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextFaint}"
                   Margin="0,0,0,6" />
        <Button Content="Шина"
                Click="OnPaletteAdd"
                Tag="Bus"
                Margin="0,0,0,10" />

        <TextBlock Text="ОБРАБОТКА"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextFaint}"
                   Margin="0,0,0,6" />
        <Button Content="Плагин…"
                Click="OnPaletteAdd"
                Tag="Plugin"
                ToolTip="Узел-плагин: VST3/CLAP в отдельном процессе (изоляция от крэшей)"
                Margin="0,0,0,10" />

        <TextBlock Text="НАЗНАЧЕНИЯ"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextFaint}"
                   Margin="0,0,0,6" />
        <Button Content="Устройство вывода"
                Click="OnPaletteAdd"
                Tag="Sink"
                Margin="0,0,0,6" />
        <Button IsEnabled="False">
          <Grid>
            <TextBlock Text="Виртуальный микрофон" VerticalAlignment="Center" />
            <TextBlock Text="Ф4"
                       FontSize="10"
                       Foreground="{DynamicResource Brush.TextFaint}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
          </Grid>
        </Button>
      </StackPanel>
    </Border>

    <Grid x:Name="Viewport"
          Grid.Row="1"
          Grid.Column="1"
          ClipToBounds="True"
          Background="{DynamicResource Brush.Deep}">
      <Canvas x:Name="World" />

      <Border HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              Margin="14"
              Background="{DynamicResource Brush.Panel}"
              BorderBrush="{DynamicResource Brush.Stroke}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.M}"
              Padding="11,7">
        <TextBlock Text="Колесо — масштаб · Пробел/СКМ — панорама · Тяни от порта L/R — канал · ПКМ — меню · Del — удалить"
                   FontSize="11"
                   Foreground="{DynamicResource Brush.TextDim}" />
      </Border>
    </Grid>

    <!-- Инспектор выделенного объекта -->
    <Border x:Name="InspectorPanel"
            Grid.Row="1"
            Grid.Column="2"
            Width="276"
            Margin="0,14,14,14"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Stroke}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.L}"
            Padding="16,14"
            Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="InspectorTitle"
                     Text="Инспектор"
                     FontWeight="SemiBold"
                     FontSize="14"
                     Foreground="{DynamicResource Brush.Text}"
                     Margin="0,0,0,12" />

          <!-- Свойства узла -->
          <StackPanel x:Name="NodeSection" Visibility="Collapsed">
            <TextBlock Text="Имя"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.TextFaint}"
                       Margin="0,0,0,4" />
            <TextBox x:Name="NodeNameBox"
                     LostFocus="OnNodeNameCommit"
                     KeyDown="OnNodeNameKeyDown" />

            <TextBlock Text="Каналы"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.TextFaint}"
                       Margin="0,12,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <ToggleButton x:Name="ChannelMonoButton"
                            Content="Моно"
                            Checked="OnChannelCountChanged"
                            Unchecked="OnChannelCountUnchecked" />
              <ToggleButton x:Name="ChannelStereoButton"
                            Content="Стерео"
                            Margin="8,0,0,0"
                            Checked="OnChannelCountChanged"
                            Unchecked="OnChannelCountUnchecked" />
            </StackPanel>
            <StackPanel x:Name="ChannelNamesHost" Margin="0,0,0,4" />

            <TextBlock Text="Устройство"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.TextFaint}"
                       Margin="0,12,0,4" />
            <ComboBox x:Name="NodeDeviceBox"
                      DisplayMemberPath="Name"
                      SelectionChanged="OnNodeDeviceChanged"
                      ToolTip="Устройство этого узла: источник захвата или вывод" />

            <TextBlock Text="Гейн"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.TextFaint}"
                       Margin="0,12,0,4" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="NodeGainSlider"
                      Minimum="-60"
                      Maximum="6"
                      ValueChanged="OnNodeGainChanged"
                      VerticalAlignment="Center"
                      ToolTip="Гейн узла, дБ (-60…+6)" />
              <TextBlock x:Name="NodeGainText"
                         Grid.Column="1"
                         Width="58"
                         TextAlignment="Right"
                         FontSize="12"
                         Foreground="{DynamicResource Brush.Cyan}"
                         VerticalAlignment="Center" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <CheckBox x:Name="NodeMuteBox"
                        Content="Mute"
                        Foreground="{DynamicResource Brush.Text}"
                        Checked="OnNodeMuteChanged"
                        Unchecked="OnNodeMuteChanged"
                        Margin="0,0,16,0" />
              <CheckBox x:Name="NodeSoloBox"
                        Content="Solo"
                        Foreground="{DynamicResource Brush.Text}"
                        Checked="OnNodeSoloChanged"
                        Unchecked="OnNodeSoloChanged" />
            </StackPanel>

            <!-- Слоты-вставки эффектов (только шины) -->
            <StackPanel x:Name="SlotsSection" Visibility="Collapsed">
              <TextBlock Text="Эффекты"
                         FontSize="11"
                         Foreground="{DynamicResource Brush.TextFaint}"
                         Margin="0,12,0,4" />
              <StackPanel x:Name="SlotsHost" />
              <Button Content="+ Эффект…"
                      HorizontalAlignment="Left"
                      Margin="0,6,0,0"
                      Click="OnAddSlotClick" />

              <!-- Параметры выбранного слота (⚙) -->
              <StackPanel x:Name="ParamsSection" Visibility="Collapsed">
                <TextBlock x:Name="ParamsTitle"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.TextFaint}"
                           Margin="0,12,0,4"
                           TextWrapping="Wrap" />
                <StackPanel x:Name="ParamsHost" />
              </StackPanel>
            </StackPanel>

            <!-- Статус процесса-исполнителя узла-плагина (S-волна) -->
            <StackPanel x:Name="PluginStatusSection" Visibility="Collapsed">
              <TextBlock Text="Исполнитель"
                         FontSize="11"
                         Foreground="{DynamicResource Brush.TextFaint}"
                         Margin="0,12,0,4" />
              <TextBlock x:Name="PluginStatusText"
                         FontSize="12"
                         Foreground="{DynamicResource Brush.Text}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,4" />
              <TextBlock x:Name="PluginStatusError"
                         FontSize="11"
                         Foreground="{DynamicResource Brush.Danger}"
                         TextWrapping="Wrap"
                         Visibility="Collapsed"
                         Margin="0,0,0,6" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="PluginRestartButton"
                        Content="Перезапустить"
                        Click="OnPluginRestartClick"
                        Margin="0,0,8,0"
                        ToolTip="Убить и заново поднять процесс-исполнитель этого узла" />
                <Button x:Name="PluginEditorButton"
                        Content="Редактор…"
                        Click="OnPluginEditorClick"
                        ToolTip="Открыть окно редактора плагина — в его процессе" />
              </StackPanel>
            </StackPanel>

            <Button Content="Показать в микшере"
                    HorizontalAlignment="Left"
                    Margin="0,16,0,0"
                    Click="OnShowInMixerClick"
                    ToolTip="Перейти на вкладку «Микшер» — пульт этого узла подсвечен и прокручен в вид" />

            <Button Content="Удалить узел"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    Click="OnDeleteNodeClick" />
          </StackPanel>

          <!-- Свойства кабеля -->
          <StackPanel x:Name="RouteSection" Visibility="Collapsed">
            <TextBlock x:Name="RouteEndpoints"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextDim}"
                       Margin="0,0,0,12" />

            <TextBlock Text="Каналы"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.TextFaint}"
                       Margin="0,0,0,6" />
            <UniformGrid Columns="2">
              <CheckBox x:Name="ChLeftLeft"
                        Content="L → L"
                        Foreground="{DynamicResource Brush.Text}"
                        Checked="OnChannelChanged"
                        Unchecked="OnChannelChanged"
                        Margin="0,2,8,2" />
              <CheckBox x:Name="ChLeftRight"
                        Content="L → R"
                        Foreground="{DynamicResource Brush.Text}"
                        Checked="OnChannelChanged"
                        Unchecked="OnChannelChanged"
                        Margin="0,2,8,2" />
              <CheckBox x:Name="ChRightLeft"
                        Content="R → L"
                        Foreground="{DynamicResource Brush.Text}"
                        Checked="OnChannelChanged"
                        Unchecked="OnChannelChanged"
                        Margin="0,2,8,2" />
              <CheckBox x:Name="ChRightRight"
                        Content="R → R"
                        Foreground="{DynamicResource Brush.Text}"
                        Checked="OnChannelChanged"
                        Unchecked="OnChannelChanged"
                        Margin="0,2,8,2" />
            </UniformGrid>

            <TextBlock Text="Гейн"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.TextFaint}"
                       Margin="0,12,0,4" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="RouteGainSlider"
                      Minimum="-60"
                      Maximum="6"
                      ValueChanged="OnRouteGainChanged"
                      VerticalAlignment="Center"
                      ToolTip="Гейн маршрута (кабеля), дБ (-60…+6)" />
              <TextBlock x:Name="RouteGainText"
                         Grid.Column="1"
                         Width="58"
                         TextAlignment="Right"
                         FontSize="12"
                         Foreground="{DynamicResource Brush.Cyan}"
                         VerticalAlignment="Center" />
            </Grid>

            <CheckBox x:Name="RouteEnabledBox"
                      Content="Маршрут включён"
                      Foreground="{DynamicResource Brush.Text}"
                      Margin="0,12,0,0"
                      Checked="OnRouteEnabledChanged"
                      Unchecked="OnRouteEnabledChanged" />

            <Button Content="Удалить кабель"
                    HorizontalAlignment="Left"
                    Margin="0,16,0,0"
                    Click="OnDeleteRouteClick" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
