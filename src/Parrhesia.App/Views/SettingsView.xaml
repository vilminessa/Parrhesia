<UserControl x:Class="Parrhesia.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
  <Grid Margin="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="720"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
        <Border Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Stroke}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.L}"
                Padding="18,16">
          <StackPanel>
            <TextBlock Text="Профили"
                       FontWeight="SemiBold"
                       FontSize="15"
                       Foreground="{DynamicResource Brush.Text}"
                       Margin="0,0,0,6" />
            <TextBlock Text="Профиль — полная копия схемы (как сцена в OBS). Переключение — по вкладкам в шапке окна; правки активного сохраняются автоматически."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextDim}"
                       Margin="0,0,0,14" />

            <ListBox x:Name="ProfileList"
                     Height="220"
                     Background="{DynamicResource Brush.Elevated}"
                     BorderBrush="{DynamicResource Brush.Stroke}"
                     BorderThickness="1"
                     Foreground="{DynamicResource Brush.Text}" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="Открыть папку профилей"
                      Click="OnOpenFolderClick"
                      ToolTip="Проводник: %APPDATA%\Parrhesia\profiles" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Вид: темы (механика Synfronia: сид + своя папка + мгновенно) -->
        <Border Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Stroke}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.L}"
                Padding="18,16"
                Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Вид"
                       FontWeight="SemiBold"
                       FontSize="15"
                       Foreground="{DynamicResource Brush.Text}"
                       Margin="0,0,0,6" />
            <TextBlock Text="Тема применяется сразу. Свои темы: папка themes в %APPDATA%\Parrhesia (подпапка с theme.json) — появляется в списке без перезапуска; ⚠ — в теме есть некорректные значения."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextDim}"
                       Margin="0,0,0,12" />
            <StackPanel x:Name="ThemeList" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
