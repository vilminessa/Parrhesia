<UserControl x:Class="Parrhesia.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Статус движка -->
    <Border Grid.Row="0"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Stroke}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.L}"
            Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="StatusText"
                   Text="—"
                   Foreground="{DynamicResource Brush.Text}"
                   FontSize="13"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <Button Grid.Column="1"
                Content="Перезапустить"
                Click="OnRestartClick"
                ToolTip="Остановить и заново открыть звуковой тракт" />
      </Grid>
    </Border>

    <!-- Списки устройств -->
    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{DynamicResource Brush.Elevated}"
              BorderBrush="{DynamicResource Brush.Stroke}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.L}"
              Padding="14">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="Вывод"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Foreground="{DynamicResource Brush.Text}"
                     Margin="0,0,0,10" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RenderList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Brush.Panel}"
                          BorderBrush="{DynamicResource Brush.Stroke}"
                          BorderThickness="1"
                          CornerRadius="{DynamicResource Radius.M}"
                          Padding="10,7"
                          Margin="0,0,0,6">
                    <Grid>
                      <TextBlock Text="{Binding Name}"
                                 Foreground="{DynamicResource Brush.Text}"
                                 FontSize="12.5"
                                 TextTrimming="CharacterEllipsis" />
                      <Border HorizontalAlignment="Right"
                              Background="{DynamicResource Brush.Accent}"
                              CornerRadius="{DynamicResource Radius.S}"
                              Padding="6,1"
                              Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="по умолчанию"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#FF1A1408" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="2"
              Background="{DynamicResource Brush.Elevated}"
              BorderBrush="{DynamicResource Brush.Stroke}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Radius.L}"
              Padding="14">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="Ввод"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Foreground="{DynamicResource Brush.Text}"
                     Margin="0,0,0,10" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CaptureList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Brush.Panel}"
                          BorderBrush="{DynamicResource Brush.Stroke}"
                          BorderThickness="1"
                          CornerRadius="{DynamicResource Radius.M}"
                          Padding="10,7"
                          Margin="0,0,0,6">
                    <Grid>
                      <TextBlock Text="{Binding Name}"
                                 Foreground="{DynamicResource Brush.Text}"
                                 FontSize="12.5"
                                 TextTrimming="CharacterEllipsis" />
                      <Border HorizontalAlignment="Right"
                              Background="{DynamicResource Brush.Accent}"
                              CornerRadius="{DynamicResource Radius.S}"
                              Padding="6,1"
                              Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="по умолчанию"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#FF1A1408" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Лента лога движка -->
    <Border Grid.Row="2"
            Margin="0,14,0,0"
            Background="{DynamicResource Brush.Elevated}"
            BorderBrush="{DynamicResource Brush.Stroke}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.L}"
            Padding="14,10">
      <TextBlock x:Name="LogText"
                 Text="Лог пуст"
                 FontFamily="Consolas"
                 FontSize="11"
                 LineHeight="16"
                 Foreground="{DynamicResource Brush.TextDim}"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
