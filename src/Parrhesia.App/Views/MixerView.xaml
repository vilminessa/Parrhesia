<UserControl x:Class="Parrhesia.App.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Статус движка -->
    <Border Grid.Row="0"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Stroke}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,10"
            Margin="0,0,0,14">
      <TextBlock x:Name="StatusText"
                 Text="—"
                 FontSize="13"
                 Foreground="{DynamicResource Brush.Text}"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- Полосы каналов -->
    <Border Grid.Row="1"
            Background="{DynamicResource Brush.Elevated}"
            BorderBrush="{DynamicResource Brush.Stroke}"
            BorderThickness="1"
            CornerRadius="8">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="StripsHost" Orientation="Horizontal" Margin="14" />
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="2"
               Text="Двойной клик по имени — переименование · ПКМ — удаление · M — перекрытие · S — соло · B — обход"
               FontSize="11"
               Foreground="{DynamicResource Brush.TextFaint}"
               HorizontalAlignment="Center"
               Margin="0,10,0,0" />
  </Grid>
</UserControl>
