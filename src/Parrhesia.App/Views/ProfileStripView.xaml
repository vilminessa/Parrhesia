<UserControl x:Class="Parrhesia.App.Views.ProfileStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
  <Border Background="{DynamicResource Brush.Elevated}"
          BorderBrush="{DynamicResource Brush.Stroke}"
          BorderThickness="0,0,0,1">
    <DockPanel Margin="10,5">
      <Border x:Name="AddButton"
              DockPanel.Dock="Right"
              Width="30"
              Height="26"
              CornerRadius="5"
              Background="Transparent"
              Cursor="Hand"
              ToolTip="Новый профиль"
              MouseLeftButtonDown="OnAddClick">
        <TextBlock Text="+"
                   FontSize="16"
                   Foreground="{DynamicResource Brush.TextDim}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>

      <StackPanel x:Name="TabsHost" Orientation="Horizontal" />
    </DockPanel>
  </Border>
</UserControl>
