<UserControl x:Class="Parrhesia.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Панель метрик -->
    <Border Grid.Row="0"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Stroke}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.L}"
            Padding="16,10"
            Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="FPS"
                     Foreground="{DynamicResource Brush.TextFaint}"
                     FontSize="12"
                     VerticalAlignment="Center"
                     ToolTip="Кадров интерфейса в секунду (норма ≈60)" />
          <TextBlock x:Name="FpsText"
                     Text="—"
                     Foreground="{DynamicResource Brush.Cyan}"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Margin="7,0,22,0"
                     VerticalAlignment="Center" />

          <TextBlock Text="Кадр"
                     Foreground="{DynamicResource Brush.TextFaint}"
                     FontSize="12"
                     VerticalAlignment="Center"
                     ToolTip="Длительность кадра отрисовки, мс (норма ≈16.7)" />
          <TextBlock x:Name="FrameText"
                     Text="—"
                     Foreground="{DynamicResource Brush.Cyan}"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Margin="7,0,22,0"
                     VerticalAlignment="Center" />

          <TextBlock Text="CPU"
                     Foreground="{DynamicResource Brush.TextFaint}"
                     FontSize="12"
                     VerticalAlignment="Center"
                     ToolTip="Загрузка процессора приложением на кадр, %" />
          <TextBlock x:Name="CpuText"
                     Text="—"
                     Foreground="{DynamicResource Brush.Cyan}"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Margin="7,0,22,0"
                     VerticalAlignment="Center" />

          <TextBlock Text="Метров"
                     Foreground="{DynamicResource Brush.TextFaint}"
                     FontSize="12"
                     VerticalAlignment="Center"
                     ToolTip="Число LED-метров на странице (синтетическая нагрузка)" />
          <TextBlock x:Name="MetersText"
                     Text="—"
                     Foreground="{DynamicResource Brush.Text}"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Margin="7,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Button Grid.Column="1"
                x:Name="StressButton"
                Click="OnStressClick"
                Content="Стресс: выкл"
                ToolTip="Синтетическая нагрузка на отрисовку: выключите для честного замера FPS" />
      </Grid>
    </Border>

    <!-- Задержка по этапам тракта (M-волна) -->
    <Border Grid.Row="1"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Stroke}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.L}"
            Padding="16,10"
            Margin="0,0,0,14">
      <StackPanel>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Text="Задержка по этапам"
                     Foreground="{DynamicResource Brush.Text}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="LatencyTotalText"
                     Grid.Column="1"
                     Text="—"
                     Foreground="{DynamicResource Brush.Cyan}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Margin="14,0,0,0"
                     VerticalAlignment="Center"
                     ToolTip="Расчётная сумма задержек всех этапов тракта (мс)" />
          <TextBlock x:Name="LatencyIssuesText"
                     Grid.Column="2"
                     Text=""
                     Foreground="{DynamicResource Brush.Danger}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Margin="14,0,0,0"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Visibility="Collapsed" />
        </Grid>

        <ItemsControl x:Name="LatencyList" MaxHeight="200">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           Foreground="{DynamicResource Brush.Text}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Ms, StringFormat={}{0:0.0} мс}"
                           Foreground="{DynamicResource Brush.Cyan}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Detail}"
                           Foreground="{DynamicResource Brush.TextFaint}"
                           FontSize="11"
                           Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Сетка метров -->
    <Border Grid.Row="2"
            Background="{DynamicResource Brush.Elevated}"
            BorderBrush="{DynamicResource Brush.Stroke}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.L}">
      <UniformGrid x:Name="Meters" Columns="10" Margin="12" />
    </Border>
  </Grid>
</UserControl>
