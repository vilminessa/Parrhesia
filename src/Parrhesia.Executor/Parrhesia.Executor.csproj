<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Консольный процесс-исполнитель (P-волна): подсистема CONSOLE —
         «юридически капризные» модули (класс Clear: в GUI-процессе не
         инициализируются, в консоли грузятся за~9 с) здесь живут. WPF
         подключён только под окна редакторов плагинов. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parrhesia.Plugins\Parrhesia.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms-конфликты имён не нужны (окна редактора — чистый WPF). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Drawing.Imaging" />
  </ItemGroup>

</Project>
